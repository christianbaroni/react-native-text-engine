{
  "name": "react-native-pretext",
  "version": "0.1.0",
  "description": "Worklet-friendly prepared text measurement and layout for React Native",
  "main": "lib/commonjs/index",
  "module": "lib/module/index",
  "types": "lib/typescript/index.d.ts",
  "react-native": "src/index",
  "source": "src/index",
  "exports": {
    ".": {
      "types": "./lib/typescript/index.d.ts",
      "react-native": "./src/index.ts",
      "import": "./lib/module/index.js",
      "require": "./lib/commonjs/index.js",
      "default": "./lib/module/index.js"
    },
    "./worklets": {
      "types": "./lib/typescript/worklets.d.ts",
      "react-native": "./src/worklets.ts",
      "import": "./lib/module/worklets.js",
      "require": "./lib/commonjs/worklets.js",
      "default": "./lib/module/worklets.js"
    }
  },
  "files": [
    "src",
    "lib",
    "android",
    "common",
    "ios",
    "README.md",
    "LICENSE",
    "*.podspec",
    "!lib/typescript/example",
    "!ios/build",
    "!android/build",
    "!android/gradle",
    "!android/gradlew",
    "!android/gradlew.bat",
    "!android/local.properties",
    "!**/__tests__",
    "!**/__fixtures__",
    "!**/__mocks__",
    "!**/.*"
  ],
  "scripts": {
    "typescript": "tsc --noEmit",
    "lint": "eslint \"**/*.{js,ts,tsx}\"",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "yarn build",
    "clean": "del-cli lib",
    "build:js": "bob build",
    "build:types": "yarn exec tsc -p tsconfig.build.json --declaration --emitDeclarationOnly --outDir lib/typescript",
    "build": "yarn build:js && yarn build:types",
    "prepack": "yarn build"
  },
  "keywords": [
    "react-native",
    "ios",
    "android",
    "text",
    "text-measurement",
    "text-layout",
    "chat",
    "worklet",
    "jsi"
  ],
  "repository": "https://github.com/christianbaroni/react-native-pretext",
  "author": "Christian Baroni <7061887+christianbaroni@users.noreply.github.com> (https://github.com/christianbaroni)",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/christianbaroni/react-native-pretext/issues"
  },
  "homepage": "https://github.com/christianbaroni/react-native-pretext#readme",
  "peerDependencies": {
    "react": ">=18.2.0",
    "react-native": ">=0.72.0",
    "react-native-worklets": ">=0.8.1"
  },
  "peerDependenciesMeta": {
    "react-native-worklets": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/react": "^18.2.0",
    "@types/react-native": "^0.72.0",
    "del-cli": "^5.0.0",
    "prettier": "^3.5.3",
    "react-native-builder-bob": "^0.20.0",
    "react-native-worklets": "^0.8.1",
    "release-it": "^15.0.0",
    "typescript": "^5.0.0"
  },
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      "commonjs",
      "module"
    ]
  },
  "codegenConfig": {
    "name": "RNPretextSpec",
    "type": "all",
    "jsSrcsDir": "src",
    "ios": {
      "componentProvider": {
        "RNPretextGlyphFieldView": "RNPretextGlyphFieldViewComponentView",
        "RNPretextPreparedTextView": "RNPretextPreparedTextViewComponentView",
        "RNPretextTextView": "RNPretextTextViewComponentView"
      }
    },
    "android": {
      "javaPackageName": "com.rnpretext"
    }
  }
}
