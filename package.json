{
  "name": "react-native-text-engine",
  "version": "0.3.1",
  "packageManager": "yarn@4.13.0",
  "description": "Fast, worklet-compatible text primitives for React Native",
  "main": "lib/commonjs/index",
  "module": "lib/module/index",
  "types": "lib/typescript/index.d.ts",
  "react-native": "src/index",
  "source": "src/index",
  "exports": {
    ".": {
      "types": "./lib/typescript/index.d.ts",
      "react-native": "./src/index.ts",
      "import": "./lib/module/index.js",
      "require": "./lib/commonjs/index.js",
      "default": "./lib/module/index.js"
    },
    "./config": {
      "types": "./lib/typescript/config.d.ts",
      "react-native": "./src/config.ts",
      "import": "./lib/module/config.js",
      "require": "./lib/commonjs/config.js",
      "default": "./lib/module/config.js"
    },
    "./worklets": {
      "types": "./lib/typescript/worklets.d.ts",
      "react-native": "./src/worklets.ts",
      "import": "./lib/module/worklets.js",
      "require": "./lib/commonjs/worklets.js",
      "default": "./lib/module/worklets.js"
    },
    "./package.json": "./package.json",
    "./babel-plugin": {
      "types": "./scripts/babel-plugin-textview.d.cts",
      "default": "./scripts/babel-plugin-textview.cjs"
    }
  },
  "files": [
    "src",
    "lib",
    "android",
    "common",
    "ios",
    "react-native.config.js",
    "README.md",
    "LICENSE",
    "scripts",
    "babel-plugin.js",
    "config.js",
    "worklets.js",
    "*.podspec",
    "!lib/typescript/example",
    "!ios/build",
    "!android/build",
    "!android/src/test",
    "!android/src/androidTest",
    "!android/src/nativeTest",
    "!android/gradle",
    "!android/gradlew",
    "!android/gradlew.bat",
    "!android/local.properties",
    "!**/__tests__",
    "!**/__fixtures__",
    "!**/__mocks__",
    "!**/.*"
  ],
  "scripts": {
    "typescript": "tsc --noEmit",
    "clean:src-artifacts": "node ./scripts/clean-source-artifacts.mjs",
    "test:android": "cd examples/android && ./gradlew :react-native-text-engine:connectedReleaseAndroidTest -PrnteNativeTests=true -Pandroid.testInstrumentationRunnerArguments.class=com.rntextengine.RNTextEngineBindingsInstrumentedTest,com.rntextengine.RNTextEngineTextViewTest",
    "test:ts": "yarn clean:src-artifacts && node ./scripts/sync-text-engine-config.mjs && vitest run --config vitest.config.ts && tsc -p tsconfig.vitest.json --noEmit",
    "perf:android": "./benchmarks/run-android.sh",
    "perf:ios": "./benchmarks/run-ios.sh",
    "perf:compare:android": "./benchmarks/run-android-comparison.sh",
    "perf:compare:ios": "./benchmarks/run-ios-comparison.sh",
    "lint": "yarn lint:eslint && yarn lint:prettier",
    "lint:eslint": "eslint . --ext .ts,.tsx",
    "lint:prettier": "prettier --check .",
    "format": "prettier --write --log-level warn --ignore-path .prettierignore .",
    "format:check": "prettier --check .",
    "sync-config": "node ./scripts/sync-text-engine-config.mjs",
    "prepare": "yarn build",
    "clean": "del-cli lib && yarn clean:src-artifacts",
    "build:js": "bob build",
    "build:types": "yarn exec tsc -p tsconfig.build.json --declaration --emitDeclarationOnly --outDir lib/typescript",
    "build": "yarn clean:src-artifacts && node ./scripts/sync-text-engine-config.mjs && yarn build:js && yarn build:types",
    "prepack": "yarn build"
  },
  "keywords": [
    "react-native",
    "ios",
    "android",
    "text",
    "text-measurement",
    "text-layout",
    "chat",
    "worklet",
    "jsi"
  ],
  "repository": "https://github.com/christianbaroni/react-native-text-engine",
  "author": "Christian Baroni <7061887+christianbaroni@users.noreply.github.com> (https://github.com/christianbaroni)",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/christianbaroni/react-native-text-engine/issues"
  },
  "homepage": "https://github.com/christianbaroni/react-native-text-engine#readme",
  "engines": {
    "node": ">=20.19.0"
  },
  "peerDependencies": {
    "react": ">=18.2.0",
    "react-native": ">=0.72.0",
    "react-native-worklets": ">=0.8.3"
  },
  "peerDependenciesMeta": {
    "react-native-worklets": {
      "optional": true
    }
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@react-native/metro-config": "0.87.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.0",
    "@typescript-eslint/eslint-plugin": "^8.33.1",
    "@typescript-eslint/parser": "^8.33.1",
    "del-cli": "^5.0.0",
    "eslint": "9.28.0",
    "eslint-config-prettier": "^10.1.5",
    "eslint-plugin-jsdoc": "^61.1.4",
    "eslint-plugin-prettier": "^5.4.1",
    "eslint-plugin-react-hooks": "^7.0.0",
    "jsdom": "^26.1.0",
    "prettier": "^3.5.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-native": "0.87.1",
    "react-native-builder-bob": "^0.20.0",
    "react-native-worklets": "0.12.2",
    "release-it": "^15.0.0",
    "typescript": "^5.0.0",
    "vitest": "^4.0.8"
  },
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      "commonjs",
      "module"
    ]
  },
  "codegenConfig": {
    "name": "RNTextEngineSpec",
    "type": "all",
    "jsSrcsDir": "src",
    "ios": {
      "componentProvider": {
        "RNTextEngineGlyphFieldView": "RNTextEngineGlyphFieldViewComponentView",
        "RNTextEnginePreparedTextView": "RNTextEnginePreparedTextViewComponentView",
        "RNTextEngineTextView": "RNTextEngineTextViewComponentView"
      }
    },
    "android": {
      "javaPackageName": "com.rntextengine"
    }
  },
  "dependencies": {
    "jiti": "^2.6.1"
  }
}
