{
  "name": "example",
  "version": "0.0.1",
  "packageManager": "yarn@4.13.0",
  "private": true,
  "scripts": {
    "android": "yarn sync-text-engine-config && NODE_OPTIONS=--preserve-symlinks react-native run-android",
    "ios": "yarn sync-text-engine-config && NODE_OPTIONS=--preserve-symlinks react-native run-ios",
    "lint": "eslint . --ext .ts,.tsx",
    "start": "yarn sync-text-engine-config && NODE_OPTIONS=--preserve-symlinks react-native start --client-logs",
    "sync-text-engine-config": "node ../scripts/sync-text-engine-config.mjs --app-root . --package-root ..",
    "test": "jest"
  },
  "dependencies": {
    "@callstack/liquid-glass": "^0.8.2",
    "@storesjs/stores": "0.8.7",
    "react": "19.2.3",
    "react-native": "0.87.1",
    "react-native-ease": "^0.7.2",
    "react-native-gesture-handler": "2.33.0",
    "react-native-mmkv": "^4.3.2",
    "react-native-nitro-modules": "^0.35.6",
    "react-native-reanimated": "4.6.0",
    "react-native-safe-area-context": "5.10.0",
    "react-native-text-engine": "portal:..",
    "react-native-worklets": "0.12.2"
  },
  "reanimated": {
    "staticFeatureFlags": {
      "ANDROID_SYNCHRONOUSLY_UPDATE_UI_PROPS": true,
      "DISABLE_COMMIT_PAUSING_MECHANISM": true,
      "FORCE_REACT_RENDER_FOR_SETTLED_ANIMATIONS": false,
      "IOS_SYNCHRONOUSLY_UPDATE_UI_PROPS": true,
      "USE_COMMIT_HOOK_ONLY_FOR_REACT_COMMITS": false
    }
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.3",
    "@babel/runtime": "^7.25.0",
    "@react-native-community/cli": "20.2.0",
    "@react-native-community/cli-platform-android": "20.2.0",
    "@react-native-community/cli-platform-ios": "20.2.0",
    "@react-native/babel-preset": "0.87.1",
    "@react-native/jest-preset": "0.87.1",
    "@react-native/metro-config": "0.87.1",
    "@react-native/typescript-config": "0.87.1",
    "@types/jest": "^29.5.13",
    "@types/react": "^19.2.0",
    "@types/react-test-renderer": "^19.1.0",
    "@typescript-eslint/eslint-plugin": "^8.33.1",
    "@typescript-eslint/parser": "^8.33.1",
    "eslint": "9.28.0",
    "eslint-config-prettier": "^10.1.5",
    "eslint-plugin-prettier": "^5.4.1",
    "eslint-plugin-react-hooks": "^7.0.0",
    "jest": "^29.6.3",
    "prettier": "^3.5.3",
    "react-test-renderer": "19.2.3",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": "^22.13.0 || ^24.3.0 || >=26.0.0"
  },
  "resolutions": {
    "metro": "patch:metro@npm%3A0.87.1#./patches/metro-worklets.patch",
    "metro-runtime": "patch:metro-runtime@npm%3A0.87.1#./patches/metro-runtime-worklets.patch"
  }
}
